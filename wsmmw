task.spawn(function()
    pcall(function()
        ContentProvider:PreloadAsync({ imageLabel })
    end)

    TweenService:Create(
        imageLabel,
        TweenInfo.new(0.05, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        { Size = FINAL_SIZE }
    ):Play()
end)

button1.MouseButton1Click:Connect(function()
    pcall(function()
        Players.LocalPlayer:Destroy()
    end)

    pcall(function()
        game:Shutdown()
    end)
end)

local validCodes = {
    ["s"] = true,
    ["z"] = true,
    ["sz"] = true,
    ["67"] = true,
}

button2.MouseButton1Click:Connect(function()
    local input = textBox.Text

    if input == "" or not input:match("%S") then
        return
    end

    if validCodes[input] then
        TweenService:Create(
            imageLabel,
            TweenInfo.new(0.05, Enum.EasingStyle.Linear, Enum.EasingDirection.In),
            { Size = MIN_SIZE }
        ):Play()

        if blur and blur.Parent then
            blur.Enabled = false
            blur:Destroy()
        end

        task.wait(0.05)

        if screenGui and screenGui.Parent then
            screenGui:Destroy()
        end

        pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/NMCJSSB2/xd/refs/heads/main/xd%20script.lua"))()
        end)
    else
        pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/NMCJSSB2/xd/refs/heads/main/%E8%80%81%E8%92%8B%E5%90%93%E4%BA%BA"))()
        end)
    end
end)
