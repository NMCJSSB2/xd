local fileUrl    = "https://raw.githubusercontent.com/NMCJSSB2/xd/main/%E8%92%8B%E4%BB%8B%E7%9F%B3.mp3"

local function stopMusic()
    local old = workspace:FindFirstChild("LocalMusicPlayer")
    if old then
        old:Stop()
        old:Destroy()
    end
end

local function startMusic()
    if not isfolder(folderName) then
        makefolder(folderName)
    end

    if not isfile(filePath) then
        local success, content = pcall(function()
            return game:HttpGet(fileUrl)
        end)

        if not (success and content and #content > 0) then
            return
        end

        writefile(filePath, content)
    end

    local ok, assetId = pcall(function()
        return getcustomasset(filePath)
    end)

    if not ok then
        return
    end

    local old = workspace:FindFirstChild("LocalMusicPlayer")
    if old then old:Destroy() end

    local sound = Instance.new("Sound")
    sound.Name = "LocalMusicPlayer"
    sound.SoundId = assetId
    sound.Volume = 1
    sound.Looped = true
    sound.Parent = workspace
    sound:Play()
end

