local isAlive = true

local activeTouch = nil
local activeInput = nil
local pressStartPos = nil
local didDrag = false
local CLICK_THRESHOLD = 6

local function getTouch(input)
    local ok, t = pcall(function() return input.Touch end)
    if ok then return t end
    return nil
end

local function pointInIcon(p)
    if not isAlive or not imageLabel or not imageLabel.Parent then return false end
    local absPos = imageLabel.AbsolutePosition
    local absSize = imageLabel.AbsoluteSize
    return p.X >= absPos.X and p.X <= absPos.X + absSize.X
       and p.Y >= absPos.Y and p.Y <= absPos.Y + absSize.Y
end

local function toggleNexusUI()
    if NexusUI and NexusUI.Parent then
        NexusUI.Enabled = not NexusUI.Enabled
    end
end

UIS.InputBegan:Connect(function(input, gameProcessed)
    if not isAlive then return end

    local isTouch = input.UserInputType == Enum.UserInputType.Touch
    local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
    if not (isTouch or isMouse) then return end
    if not input.Position then return end
    if not pointInIcon(input.Position) then return end

    activeInput = input
    activeTouch = isTouch and getTouch(input) or nil
    pressStartPos = Vector2.new(input.Position.X, input.Position.Y)
    didDrag = false
end)

UIS.InputChanged:Connect(function(changed)
    if not isAlive then return end
    if not activeInput then return end

    if activeTouch then
        if changed.UserInputType ~= Enum.UserInputType.Touch then return end
        local ct = getTouch(changed)
        if ct ~= activeTouch then return end
    else
        if activeInput and activeInput.UserInputType == Enum.UserInputType.Touch then
            if changed ~= activeInput then return end
        else
            if changed.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        end
    end

    if pressStartPos and not didDrag then
        local curPos = Vector2.new(changed.Position.X, changed.Position.Y)
        if (curPos - pressStartPos).Magnitude > CLICK_THRESHOLD then
            didDrag = true
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    if not isAlive then return end
    if not activeInput then return end

    local isTouch = input.UserInputType == Enum.UserInputType.Touch
    local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
    if not (isTouch or isMouse) then return end

    local shouldStop = false
    if isTouch then
        local t = getTouch(input)
        if (t and t == activeTouch) or (not activeTouch and input == activeInput) then
            shouldStop = true
        end
    else
        shouldStop = true
    end

    if not shouldStop then return end

    if not didDrag and input.Position and pointInIcon(input.Position) then
        toggleNexusUI()
    end

    activeInput = nil
    activeTouch = nil
    pressStartPos = nil
    didDrag = false
end)

local function cleanupButton()
    if not isAlive then return end
    isAlive = false
    activeInput = nil
    activeTouch = nil
    if screenGui and screenGui.Parent then
        screenGui:Destroy()
    end
    screenGui = nil
    rootFrame = nil
    mainButton = nil
    imageLabel = nil
end

NexusUI.AncestryChanged:Connect(function(_, newParent)
    if newParent ~= CoreGui then
        cleanupButton()
    end
end)

NexusUI.Destroying:Connect(function()
    cleanupButton()
end)

if NexusUI.Parent ~= CoreGui then
    cleanupButton()
end
